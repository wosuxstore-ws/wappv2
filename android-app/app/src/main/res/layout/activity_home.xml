<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/homeSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- ============ Header (static) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp">

                    <ImageView
                        android:id="@+id/menuButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_grid"
                        android:contentDescription="Menu"
                        app:tint="@color/home_title"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="WOSUX"
                        android:textColor="@color/home_title"
                        android:textSize="22sp"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/poppins_bold" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_search"
                        android:contentDescription="Search"
                        app:tint="@color/home_title" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_bell"
                            android:contentDescription="Notifications"
                            app:tint="@color/home_title" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="9dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_dot_red" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ============ Latest orders (DYNAMIC) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Latest orders"
                        android:textColor="@color/home_title"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/ordersSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="See all"
                        android:textColor="@color/home_blue"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ordersRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/ordersMessage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_tile"
                        android:gravity="center"
                        android:padding="16dp"
                        android:textColor="@color/home_nav_inactive"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="No orders yet"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- ============ Categories (static) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Categories"
                        android:textColor="@color/home_title"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="See all"
                        android:textColor="@color/home_blue"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            style="@style/HomeChip"
                            android:background="@drawable/bg_chip_selected"
                            android:text="Handsfree" />

                        <TextView
                            style="@style/HomeChip"
                            android:text="Headphones" />

                        <TextView
                            style="@style/HomeChip"
                            android:text="Data cables" />

                        <TextView
                            style="@style/HomeChip"
                            android:text="Chargers" />

                        <TextView
                            style="@style/HomeChip"
                            android:layout_marginEnd="0dp"
                            android:text="Power banks" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ============ Products (static) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Products"
                        android:textColor="@color/home_title"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="See all"
                        android:textColor="@color/home_blue"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============ Bottom navigation (static) ============ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_nav_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/home_nav_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout style="@style/HomeNavItem">
            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_home"
                app:tint="@color/home_blue" />
            <TextView
                style="@style/HomeNavLabel"
                android:text="Home"
                android:textColor="@color/home_blue"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <LinearLayout style="@style/HomeNavItem">
            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_box"
                app:tint="@color/home_nav_inactive" />
            <TextView
                style="@style/HomeNavLabel"
                android:text="Stock" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_scan"
                android:padding="11dp"
                android:src="@drawable/ic_scan"
                android:contentDescription="Scan"
                app:tint="@color/home_blue" />
        </FrameLayout>

        <LinearLayout style="@style/HomeNavItem">
            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_chart"
                app:tint="@color/home_nav_inactive" />
            <TextView
                style="@style/HomeNavLabel"
                android:text="Reports" />
        </LinearLayout>

        <LinearLayout style="@style/HomeNavItem">
            <ImageView
                style="@style/HomeNavIcon"
                android:src="@drawable/ic_users"
                app:tint="@color/home_nav_inactive" />
            <TextView
                style="@style/HomeNavLabel"
                android:text="Customers" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
